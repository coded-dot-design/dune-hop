{
  "name": "@coded-design/dune-hop",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Dune Hop: a cyberpunk-desert off-road racer on a tabletop. Built on Fizlet, by Chris Cooley.",
  "license": "MIT",
  "author": "Chris Cooley (https://coded.design/)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "size": "node scripts/size.mjs",
    "check": "npm run build && npm run size",
    "test": "node --expose-gc --test --test-concurrency=1 tests/*.test.mjs",
    "test:settle": "node tests/settle.mjs",
    "test:browser": "node tests/browser.mjs && node tests/online.mjs",
    "site:dev": "astro dev --config site/astro.config.mjs",
    "site:build": "astro build --config site/astro.config.mjs && node scripts/pages.mjs",
    "test:site": "node tests/site.mjs"
  },
  "devDependencies": {
    "@fzlt/core": "^0.22.0",
    "astro": "7.4.2",
    "esbuild": "0.28.2",
    "playwright": "1.58.2",
    "typescript": "7.0.2"
  }
}
