---
// Dune Hop, the landing page. The hero is the game itself: an attract lap of Neon Edge in the chase
// view (tap to take the wheel); reduced motion shows a still poster that links to /play/.
import Base from '../layouts/Base.astro';
import { base, GZIP, FIZLET, REPO } from '../site';
import { TRACKS } from '../../../src/tracks.ts';
const description = 'Dune Hop is a cyberpunk-desert off-road racer on a tabletop: four tracks, three rivals, a Freestyle park of four tables to jump between, two players on one screen or online, jumps scored for airtime and clean landings. Free in the browser, by Chris Cooley, built on Fizlet.';
const kb = (GZIP / 1024).toFixed(1);
const steps = [
  ['GAS & STEER', 'Hold ↑ (or W) for gas, ← → to steer, ↓ to brake. On a phone: GAS, BRAKE, DRIFT and BOOST on the right, steer on the left. A mouse? Hold the course for gas, drag to steer.'],
  ['FLY IT', 'Off a kicker, gas lifts the nose and the brake dips it. Land it flat: a clean landing scores the airtime and builds a combo.'],
  ['DRIFT & NITRO', 'Shift (or DRIFT) steps the tail out: hold the slide for drift points. Clean landings and drifts fill NITRO: hold Space (or BOOST) on a straight. Pink boost pads on the track give anyone a free shove.'],
  ['TAKE THE FLAG', 'Every gate in order, three laps, three rivals. Nose in or roll it and you tumble back to the last gate. Your best time per track is kept.'],
  ['FREESTYLE', 'No race, no clock: four big tables side by side, a launch ramp on every gap. Fly from table to table; air, transfers and drift chains score, and every move inside the combo window multiplies the next.'],
  ['TWO PLAYERS', 'Split screen on one device: P1 on W A S D, left Shift and Space; P2 on the arrows, right Shift and Enter; two gamepads; on a tablet each half gets its own pad. Or online: the same invite code and room on two screens.'],
];
const features = [
  ['Four tabletop tracks', 'From a short sunset loop to a night run at the city\'s edge, each bigger and busier than the last.'],
  ['Split routes', 'Split Canyon and Neon Edge fork: the long way, or the shortcut over the gap. Pick each lap.'],
  ['Rivals who race', 'VOLT, MIRAGE and RUST read the same line you do, brake for the bends, take shortcuts, step round other cars (or lean on them) and crash too.'],
  ['Jumps of every size', 'Kickers, gap jumps with a landing ramp, whoops, crests and banked turns, every lip marked.'],
  ['Night and day', 'Neon contour dunes at night, a hot sunset by day: it follows your light or dark theme.'],
  ['Freestyle park', 'Salt Flats, The Bowl, Dune Sea and Neon Yard: kickers, a bowl, a spine, dunes, ledges and a rail, each table its own look, linked by launch ramps.'],
  ['Two players', 'Split screen with a view each (side by side, or stacked on a tall screen), or online over a room: race or a three-minute Freestyle jam, then a rematch.'],
  ['Same seed, same race', 'The race is deterministic and seeded: online, only the inputs travel and both screens run the same race, checked frame by frame.'],
];
const bricks = ['kernel', 'diorama', 'terrain', 'drive', 'input', 'pad', 'sound', 'ui', 'presence'];
---
<Base title="Dune Hop · an off-road racer on a tabletop" description={description}>
  <section class="dh-hero" aria-labelledby="dh-title">
    <div class="dh-stage" id="dh-hero" aria-label="Dune Hop demo lap: tap to take the wheel"></div>
    <a class="dh-poster" href={base('play/')} hidden><img src={base('shots/hero.jpg')} alt="Dune Hop: four buggies racing at night through neon-lit dunes at the edge of a city" width="1600" height="900" /></a>
    <div class="wrap dh-copy">
      <p class="eyebrow"><span class="dot"></span> A DOM VIRUS GAME · BY CHRIS COOLEY</p>
      <h1 id="dh-title">Dune Hop.<br /><em>Fly the dunes.</em></h1>
      <p class="lead">An off-road racer on a tabletop. Four tracks, three rivals, every jump scored. A Freestyle park to fly between tables. Two players on one screen, or online. Neon at night, a hot sunset by day.</p>
      <div class="dh-ctas">
        <a class="bui-key bui-sticker-key bui-call start-key" href={base('play/')}><b>PLAY</b><span>free · in your browser</span></a>
        <p class="dh-tap">Or tap the race to take the wheel.</p>
      </div>
    </div>
  </section>

  <section class="section" id="how">
    <div class="wrap">
      <p class="eyebrow"><span class="index">01</span> HOW TO PLAY</p>
      <h2>Gas, steer, fly, land.</h2>
      <ol class="cards">
        {steps.map(([k, b], i) => <li class="panel"><span class="n">0{i + 1}</span><h3>{k}</h3><p>{b}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section" id="tracks">
    <div class="wrap">
      <p class="eyebrow"><span class="index">02</span> THE TRACKS</p>
      <h2>Four tables, rising.</h2>
      <ol class="tracks">
        {TRACKS.map((t, i) => (
          <li class="panel">
            <span class="tier" aria-label={`Level ${t.tier} of 4`}>{'◆'.repeat(t.tier)}{'◇'.repeat(4 - t.tier)}</span>
            <h3>{i + 1}. {t.name}</h3>
            <p>{t.blurb}</p>
            <p class="meta">{t.laps} laps{t.branches ? ' · shortcut' : ''}{t.city ? ' · always night' : ''}</p>
            <a class="bui-key bui-arcade bui-sys" href={base(`play/?track=${t.id}`)}>Race it</a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="features">
    <div class="wrap">
      <p class="eyebrow"><span class="index">03</span> WHAT'S IN IT</p>
      <h2>A race, not a lap.</h2>
      <ul class="cards three">
        {features.map(([k, b]) => <li class="panel"><h3>{k}</h3><p>{b}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section" id="fizlet">
    <div class="wrap split">
      <div>
        <p class="eyebrow"><span class="index">04</span> BUILT ON FIZLET</p>
        <h2>No libraries. {kb} KB.</h2>
        <p>Dune Hop is built on <a href="https://fizlet.com/">Fizlet</a>, the micro animation and game engine for the DOM, and nothing else: no framework, no 3D library, no images in the game. The dunes, the buggies and the light trails are drawn by Fizlet's bricks on one canvas.</p>
        <p>The whole game, its Fizlet bricks and its Board UI styles: <b>{GZIP.toLocaleString('en-US')} bytes gzip</b> (measured at build, Fizlet {FIZLET}).</p>
        <ul class="bricks">{bricks.map((b) => <li><code>@fzlt/core/{b}</code></li>)}</ul>
      </div>
      <div class="panel lit by">
        <p class="eyebrow"><b>BY CHRIS COOLEY</b></p>
        <h3>It started as a tiny game.</h3>
        <p>Dune Hop began as gallery piece #098 in Fizlet's Daily: one short loop and a buggy. It was picked to grow into a full game.</p>
        <p><a href="https://coded.design/">coded.design</a> · <a href={REPO}>Source on GitHub (MIT)</a></p>
        <a class="bui-key bui-arcade bui-go" href={base('play/')}>▶ Play Dune Hop</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { createDuneHop } from "../../../dist/dune-hop.mjs";
  const host = document.getElementById("dh-hero")!;
  const poster = document.querySelector<HTMLElement>(".dh-poster")!;
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) poster.hidden = false;
  else (window as unknown as { hero: unknown }).hero = createDuneHop({ host, attract: true, track: "neon-edge", keyboard: "focus" });
</script>
